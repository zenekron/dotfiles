[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

[init]
	defaultBranch = main

[user]
	name = zenekron
	email = zenekron@gmail.com

; catppuccin/delta
; https://github.com/catppuccin/delta
[include]
	path = ~/.dotfiles/modules/catppuccin/delta/catppuccin.gitconfig

[delta]
	features = catppuccin-frappe

; delta
; https://github.com/dandavison/delta
[core]
	pager = delta

[delta]
	navigate = true

[interactive]
	diffFilter = delta --color-only

[merge]
	conflictstyle = zdiff3
