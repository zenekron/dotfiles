[core]
	pager = delta

[delta]
	navigate = true
	line-numbers = true

	file-decoration-style = bold ul ol
	file-added-label = " "
	file-copied-label = " "
	file-modified-label = " "
	file-removed-label = " "
	file-renamed-label = " "

	hunk-header-style = line-number file syntax
	hunk-header-decoration-style =

[interactive]
	diffFilter = delta --color-only

[merge]
	conflictstyle = zdiff3

# vim: ft=gitconfig
