[Unit]
Description=Mount VMware shared folder %i
Requires=vmware-vmblock-fuse.service
After=vmware-vmblock-fuse.service
ConditionPathExists=.host:/%i
ConditionVirtualization=vmware

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/vmhgfs-fuse -o allow_other -o auto_unmount .host:/%i /mnt/hgfs/%i

[Install]
WantedBy=multi-user.target
